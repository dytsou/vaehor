{
  "name": "@vaehor/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "@capacitor/app",
          "@capacitor/browser",
          "@capacitor/network",
          "@capacitor/preferences",
          "@capawesome/capacitor-background-task",
          "@capawesome/capacitor-file-picker",
          "@capgo/capacitor-native-biometric"
        ]
      },
      "android": {
        "exclude": [
          "@capacitor/app",
          "@capacitor/browser",
          "@capacitor/network",
          "@capacitor/preferences",
          "@capawesome/capacitor-background-task",
          "@capawesome/capacitor-file-picker",
          "@capgo/capacitor-native-biometric"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "pnpm start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "test": "pnpm run test:utility && pnpm run test:shell",
    "test:utility": "cd ../.. && pnpm exec vitest run apps/mobile/__tests__",
    "test:shell": "jest __tests__/app-shell.test.tsx --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@vaehor/sdk": "workspace:*",
    "expo": "~57.0.25",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-network": "~57.0.2",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "^19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.5.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capawesome/capacitor-background-task": "8.0.3",
    "@capawesome/capacitor-file-picker": "8.1.0",
    "@capgo/capacitor-native-biometric": "8.6.10",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/app-shell.test.tsx"
    ]
  }
}
