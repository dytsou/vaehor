{
  "name": "@vaehor/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "pnpm start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "export:android": "expo export --platform android",
    "export:ios": "expo export --platform ios",
    "test": "pnpm run test:utility && pnpm run test:shell",
    "test:utility": "cd ../.. && pnpm compile:sdk && pnpm exec vitest run apps/mobile/__tests__",
    "test:shell": "jest --runInBand"
  },
  "dependencies": {
    "@kishannareshpal/expo-pdf": "^0.3.2",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@vaehor/sdk": "workspace:*",
    "expo": "~58.0.16",
    "expo-audio": "~58.0.9",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-network": "~58.0.3",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "expo-web-browser": "~58.0.6",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.11",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/app-shell.test.tsx",
      "**/__tests__/container-preview.test.tsx"
    ]
  }
}
