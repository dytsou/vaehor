{
  "name": "vaehor",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "dotenv -- next dev --turbopack",
    "dev:webpack": "dotenv -- next dev",
    "build": "next build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:prod": "docker compose up --build",
    "docker:stop": "docker compose down",
    "start": "dotenv -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:6": "tsc6 --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "bash scripts/check-all.sh",
    "check:all": "npm run typecheck && npm run format:check && npm run lint",
    "fix:all": "npm run format:fix && npm run lint --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "compile:openapi": "tsp compile docs/api/spec/entry.tsp --config docs/api/spec/tspconfig.yaml",
    "build:sdk": "pnpm compile:openapi && orval --config ./orval.config.js",
    "compile:sdk": "pnpm --filter @vaehor/sdk build",
    "mcp:build": "pnpm --filter @vaehor/mcp build",
    "mcp:dev": "pnpm --filter @vaehor/mcp dev",
    "mobile:dev": "pnpm --filter @vaehor/mobile dev",
    "mobile:build": "pnpm --filter @vaehor/mobile build",
    "mobile:sync": "pnpm --filter @vaehor/mobile cap:sync",
    "mobile:sync:android": "pnpm --filter @vaehor/mobile cap:sync:android",
    "mobile:sync:ios": "pnpm --filter @vaehor/mobile cap:sync:ios",
    "build:redocly": "pnpm compile:openapi && redocly build-docs ./docs/api/openapi.yaml -o ./docs/api/website/index.html",
    "api:compile": "tsp compile docs/api/spec/entry.tsp --config docs/api/spec/tspconfig.yaml",
    "api:docs:redoc": "pnpm api:compile && redocly preview-docs ./docs/api/openapi.yaml",
    "api:sdk": "pnpm build:sdk && pnpm compile:sdk",
    "prepush": "pnpm typecheck",
    "analyze": "cross-env ANALYZE=true next build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.5",
    "@vidstack/react": "^1.12.13",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "framer-motion": "^11.18.2",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.4.2",
    "jose": "^5.4.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.424.0",
    "next": "^16.1.7",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.6.1",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^7.0.10",
    "otplib": "^12.0.1",
    "pdfjs-dist": "4.8.69",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-easy-crop": "^5.5.5",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-pdf": "^9.1.0",
    "recharts": "^3.3.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.25.0",
    "zod": "^4.1.5",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@next/bundle-analyzer": "^16.1.7",
    "@playwright/test": "^1.60.0",
    "@redocly/cli": "^2.26.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@typespec/compiler": "^1.11.0",
    "@typespec/http": "^1.11.0",
    "@typespec/openapi": "^1.11.0",
    "@typespec/openapi3": "^1.11.0",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.15",
    "autoprefixer": "^10.4.19",
    "baseline-browser-mapping": "^2.10.10",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^7.4.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "^16.1.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "jsdom": "^27.3.0",
    "lint-staged": "^15.5.2",
    "orval": "^8.7.0",
    "postcss": "^8.4.40",
    "prettier": "^3.3.3",
    "prisma": "^7.7.0",
    "tailwindcss": "^3.4.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.15"
  }
}
