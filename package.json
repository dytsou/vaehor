{
  "name": "vaehor",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "dotenv -- next dev --turbopack",
    "dev:webpack": "dotenv -- next dev --webpack",
    "dev:clean": "rm -rf .next",
    "dev:fresh": "pnpm run dev:clean && pnpm run dev",
    "deps:up": "docker compose -f docker-compose.dev.yml up -d postgres redis",
    "deps:down": "docker compose -f docker-compose.dev.yml stop postgres redis",
    "deps:logs": "docker compose -f docker-compose.dev.yml logs -f postgres redis",
    "build": "next build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:prod": "docker compose up --build",
    "docker:stop": "docker compose down",
    "start": "dotenv -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "typecheck:6": "tsc6 --noEmit",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "bash scripts/check-all.sh",
    "check:all": "npm run typecheck && npm run format:check && npm run lint",
    "fix:all": "npm run format:fix && npm run lint --fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:entrypoint": "bash scripts/test-entrypoint-integration.sh",
    "test:e2e": "playwright test",
    "ci:deps": "bash scripts/ci-install.sh",
    "ci:playwright:browsers": "playwright install chromium",
    "ci:playwright:browser-deps": "playwright install-deps chromium",
    "compile:openapi": "tsp compile docs/api/spec/entry.tsp --config docs/api/spec/tspconfig.yaml",
    "build:sdk": "pnpm compile:openapi && orval --config ./orval.config.js",
    "compile:sdk": "pnpm --filter @vaehor/sdk build",
    "mcp:build": "pnpm --filter @vaehor/mcp build",
    "mcp:dev": "pnpm --filter @vaehor/mcp dev",
    "mobile:dev": "pnpm --filter @vaehor/mobile dev",
    "mobile:build": "pnpm --filter @vaehor/mobile build",
    "mobile:sync": "pnpm --filter @vaehor/mobile cap:sync",
    "mobile:sync:android": "pnpm --filter @vaehor/mobile cap:sync:android",
    "mobile:sync:ios": "pnpm --filter @vaehor/mobile cap:sync:ios",
    "build:redocly": "pnpm compile:openapi && redocly build-docs ./docs/api/openapi.yaml -o ./docs/api/website/index.html",
    "api:compile": "tsp compile docs/api/spec/entry.tsp --config docs/api/spec/tspconfig.yaml",
    "api:docs:redoc": "pnpm build:redocly && open ./docs/api/website/index.html",
    "api:sdk": "pnpm build:sdk && pnpm compile:sdk",
    "prepush": "pnpm typecheck",
    "analyze": "cross-env ANALYZE=true next build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/bcryptjs": "^3.0.0",
    "@types/qrcode": "^1.5.5",
    "@vidstack/react": "^1.15.6",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "framer-motion": "^12.43.0",
    "google-auth-library": "^10.9.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pdfjs-dist": "6.2.108",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-pdf": "^10.4.1",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.32.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.43.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@typespec/compiler": "^1.14.0",
    "@typespec/http": "^1.14.0",
    "@typespec/openapi": "^1.14.0",
    "@typespec/openapi3": "^1.14.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "baseline-browser-mapping": "^2.11.9",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "orval": "^8.23.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
