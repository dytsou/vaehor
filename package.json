{
  "name": "vaehor",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "dotenv -- next dev --turbopack",
    "dev:webpack": "dotenv -- next dev --webpack",
    "dev:clean": "rm -rf .next",
    "dev:fresh": "pnpm run dev:clean && pnpm run dev",
    "deps:up": "docker compose -f docker-compose.dev.yml up -d postgres redis",
    "deps:down": "docker compose -f docker-compose.dev.yml stop postgres redis",
    "deps:logs": "docker compose -f docker-compose.dev.yml logs -f postgres redis",
    "build": "next build",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:prod": "docker compose up --build",
    "docker:stop": "docker compose down",
    "start": "dotenv -- next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "typecheck": "pnpm compile:sdk && tsc --noEmit && tsc -p apps/mobile/tsconfig.json --noEmit",
    "typecheck:6": "tsc6 --noEmit",
    "format:check": "biome format . && prettier --check \"**/*.{html,md,mdx,yaml,yml}\"",
    "format:fix": "biome format --write . && prettier --write \"**/*.{html,md,mdx,yaml,yml}\"",
    "check": "bash scripts/check-all.sh",
    "check:all": "pnpm typecheck && pnpm format:check && pnpm lint",
    "fix:all": "pnpm format:fix && pnpm lint:fix",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:entrypoint": "bash scripts/test-entrypoint-integration.sh",
    "test:e2e": "playwright test",
    "ci:deps": "bash scripts/ci-install.sh",
    "ci:playwright:browsers": "playwright install chromium",
    "ci:playwright:browser-deps": "playwright install-deps chromium",
    "compile:openapi": "tsp compile docs/api/spec/entry.tsp --config docs/api/spec/tspconfig.yaml",
    "build:sdk": "pnpm compile:openapi && orval --config ./orval.config.js && biome format --write ./packages/sdk/src/orval/index.ts && node scripts/normalize-orval-upload-bodies.mjs",
    "compile:sdk": "pnpm --filter @vaehor/sdk build",
    "mcp:build": "pnpm --filter @vaehor/mcp build",
    "mcp:dev": "pnpm --filter @vaehor/mcp dev",
    "mobile:dev": "pnpm --filter @vaehor/mobile dev",
    "mobile:build": "pnpm compile:sdk && pnpm --filter @vaehor/mobile run export:android && pnpm --filter @vaehor/mobile run export:ios",
    "mobile:prebuild": "pnpm --filter @vaehor/mobile prebuild",
    "mobile:android": "pnpm --filter @vaehor/mobile android",
    "mobile:ios": "pnpm --filter @vaehor/mobile ios",
    "mobile:test": "pnpm --filter @vaehor/mobile test",
    "build:redocly": "pnpm compile:openapi && redocly build-docs ./docs/api/openapi.yaml -o ./docs/api/website/index.html",
    "api:compile": "tsp compile docs/api/spec/entry.tsp --config docs/api/spec/tspconfig.yaml",
    "api:docs:redoc": "pnpm build:redocly && open ./docs/api/website/index.html",
    "api:sdk": "pnpm build:sdk && pnpm compile:sdk",
    "prepush": "pnpm typecheck",
    "analyze": "cross-env ANALYZE=true next build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,ts,tsx,mts,cts,css,json,jsonc}": [
      "biome check --write"
    ],
    "*.{html,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/qrcode": "^1.5.5",
    "@vidstack/react": "^1.15.6",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "driver.js": "^1.8.0",
    "framer-motion": "^13.4.2",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.6",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.0.9",
    "otplib": "^13.5.0",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "react-masonry-css": "^1.0.16",
    "react-pdf": "^11.0.0",
    "recharts": "^3.10.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@next/bundle-analyzer": "^16.3.6",
    "@playwright/test": "^1.63.0",
    "@redocly/cli": "^2.54.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typespec/compiler": "^1.16.0",
    "@typespec/http": "^1.16.0",
    "@typespec/openapi": "^1.16.0",
    "@typespec/openapi3": "^1.16.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "autoprefixer": "^10.6.1",
    "baseline-browser-mapping": "^2.11.26",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "orval": "^8.37.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.2"
  }
}
